<!-- ==========================================
                    MAIN
=========================================== -->


<main>


<section class="section">


<div class="container">
    <!-- ==========================================
              TRIP MANAGEMENT CONTENT
=========================================== -->


<div class="card">


<div class="card-header">


<div>


<h2 class="card-title">

Trip Management

</h2>



<p class="section-subtitle">

Create and manage transportation trips.

</p>


</div>





<button class="btn btn-primary"
        id="createTripBtn">


+ Create New Trip


</button>



</div>







<div class="card-body">





<div class="table-responsive">


<table>


<thead>


<tr>


<th>

Trip Number

</th>



<th>

Pickup Location

</th>



<th>

Destination

</th>



<th>

Departure

</th>



<th>

Arrival

</th>



<th>

Actions

</th>



</tr>


</thead>






<tbody id="tripTableBody">


@foreach (var trip in Model)
{
    <tr>

        <td>
            TR-@trip.TripID.ToString("D3")
        </td>

        <td>
            @trip.PickupLocation
        </td>

        <td>
            @trip.Destination
        </td>

        <td>
            @trip.DepartureTime.ToString(@"hh\:mm")
        </td>

        <td>
            @trip.ArrivalTime.ToString(@"hh\:mm")
        </td>

        <td>
            <button class="btn btn-secondary edit-btn">
                Edit
            </button>

            <button class="btn btn-danger delete-btn">
                Delete
            </button>
        </td>

    </tr>
}


</tbody>


</table>


</div>





</div>


</div>





</div>


</section>


</main>
