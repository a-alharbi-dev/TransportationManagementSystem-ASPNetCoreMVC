<!-- MESSAGE BOX -->


<div id="messageBox"
     class="message-box">

</div>
            <script>

                    // ==========================================
                    // MESSAGE BOX
                    // ==========================================

                    function showMessage(message, type = "success") {

                        const box = document.getElementById("messageBox");

                        if (!box) {
                            console.log(message);
                            return;
                        }

                        box.className = "message-box";

                        if (type === "error") {
                            box.classList.add("error");
                        }
                        else if (type === "warning") {
                            box.classList.add("warning");
                        }
                        else if (type === "info") {
                            box.classList.add("info");
                        }

                        box.innerHTML = message;

                        box.classList.add("show");

                        clearTimeout(box.timer);

                        box.timer = setTimeout(function() {
                            box.classList.remove("show");
                        }, 3000);
                    }



                    // ==========================================
                    // PROFILE MENU
                    // ==========================================

                    const profileBtn = document.getElementById("profileBtn");
                    const profileMenu = document.getElementById("profileMenu");

                    if (profileBtn && profileMenu) {

                        profileBtn.addEventListener("click", function(e) {

                            e.stopPropagation();

                            profileMenu.classList.toggle("show");

                        });

                        document.addEventListener("click", function() {

                            profileMenu.classList.remove("show");

                        });
                    }



                    // ==========================================
                    // GET ELEMENTS
                    // ==========================================

                    const tripModal =
                        document.getElementById("tripModal");

                    const createTripBtn =
                        document.getElementById("createTripBtn");

                    const closeTripModal =
                        document.getElementById("closeTripModal");

                    const cancelTripBtn =
                        document.getElementById("cancelTripBtn");

                    const saveTripBtn =
                        document.getElementById("saveTripBtn");

                    const tripTableBody =
                        document.getElementById("tripTableBody");

                    const tripModalTitle =
                        document.getElementById("tripModalTitle");

                    const tripNumberInput =
                        document.getElementById("tripNumber");

                    const pickupLocationInput =
                        document.getElementById("pickupLocation");

                    const destinationInput =
                        document.getElementById("destination");

                    const departureTimeInput =
                        document.getElementById("departureTime");

                    const arrivalTimeInput =
                        document.getElementById("arrivalTime");


                    // ==========================================
                    // EDIT VARIABLES
                    // ==========================================

                    let editMode = false;

                    let selectedRow = null;



                    // ==========================================
                    // CHECK ELEMENTS
                    // ==========================================

                    console.log("Trip Management JavaScript loaded.");

                    console.log("Create button:", createTripBtn);

                    console.log("Save button:", saveTripBtn);

                    console.log("Trip table:", tripTableBody);



                    // ==========================================
                    // OPEN CREATE TRIP
                    // ==========================================

                    if (createTripBtn) {

                        createTripBtn.addEventListener("click", function() {

                            editMode = false;

                            selectedRow = null;

                            if (tripModalTitle) {
                                tripModalTitle.innerText =
                                    "Create New Trip";
                            }

                            if (saveTripBtn) {
                                saveTripBtn.innerText =
                                    "Save Trip";
                            }

                            resetTripForm();

                            if (tripModal) {
                                tripModal.classList.add("show");
                            }

                        });

                    }



                    // ==========================================
                    // CLOSE MODAL
                    // ==========================================

                    if (closeTripModal) {

                        closeTripModal.addEventListener("click", function() {

                            if (tripModal) {
                                tripModal.classList.remove("show");
                            }

                        });

                    }


                    if (cancelTripBtn) {

                        cancelTripBtn.addEventListener("click", function() {

                            if (tripModal) {
                                tripModal.classList.remove("show");
                            }

                        });

                    }


                    window.addEventListener("click", function(e) {

                        if (tripModal && e.target === tripModal) {

                            tripModal.classList.remove("show");

                        }

                    });



                    // ==========================================
                    // RESET TRIP FORM
                    // ==========================================

                    function resetTripForm() {

                        editMode = false;

                        selectedRow = null;


                        if (tripNumberInput) {
                            tripNumberInput.value = "";
                        }


                        if (pickupLocationInput) {
                            pickupLocationInput.selectedIndex = 0;
                        }


                        if (destinationInput) {
                            destinationInput.selectedIndex = 0;
                        }


                        if (departureTimeInput) {
                            departureTimeInput.value = "";
                        }


                        if (arrivalTimeInput) {
                            arrivalTimeInput.value = "";
                        }

                    }



                    // ==========================================
                    // TIME CONVERTER
                    // ==========================================

                    function convertTime(time) {

                        if (!time) {
                            return "";
                        }

                        time = time.trim();

                        if (!time.includes("AM") &&
                            !time.includes("PM")) {

                            return time;

                        }


                        const parts = time.split(" ");

                        const hm = parts[0].split(":");

                        let hour = parseInt(hm[0]);

                        const minute = hm[1];

                        if (parts[1] === "PM" && hour !== 12) {
                            hour += 12;
                        }

                        if (parts[1] === "AM" && hour === 12) {
                            hour = 0;
                        }

                        return String(hour).padStart(2, "0")
                            + ":" + minute;

                    }



                    // ==========================================
                    // SAVE TRIP
                    // CREATE + UPDATE
                    // ==========================================

                    if (saveTripBtn) {

                        saveTripBtn.addEventListener(
                            "click",
                            async function() {

                                const pickup =
                                    pickupLocationInput
                                        ? pickupLocationInput.value
                                        : "";

                                const destination =
                                    destinationInput
                                        ? destinationInput.value
                                        : "";

                                const departure =
                                    departureTimeInput
                                        ? departureTimeInput.value
                                        : "";

                                const arrival =
                                    arrivalTimeInput
                                        ? arrivalTimeInput.value
                                        : "";


                                // ==========================================
                                // VALIDATION
                                // ==========================================

                                if (
                                    !pickup ||
                                    pickup === "Select Location" ||

                                    !destination ||
                                    destination === "Select Destination" ||

                                    !departure ||
                                    !arrival
                                ) {

                                    showMessage(
                                        "Please complete all required fields.",
                                        "warning"
                                    );

                                    return;
                                }

                                // ==========================================
// UPDATE EXISTING TRIP IN DATABASE
// ==========================================

if (editMode && selectedRow) {

    // Get Trip ID

    const tripText =
        selectedRow.cells[0]
            .innerText
            .trim();

    const tripId =
        parseInt(
            tripText
                .replace("TR-", "")
                .trim(),
            10
        );


    if (isNaN(tripId)) {

        showMessage(
            "Invalid Trip ID.",
            "error"
        );

        return;
    }


    // Prepare data

    const data =
        new URLSearchParams();


    data.append(
        "tripId",
        tripId
    );

    data.append(
        "pickupLocation",
        pickup
    );

    data.append(
        "destination",
        destination
    );

    data.append(
        "departureTime",
        departure
    );

    data.append(
        "arrivalTime",
        arrival
    );


    saveTripBtn.disabled = true;

    saveTripBtn.innerText =
        "Updating...";


    try {

        console.log(
            "Updating Trip:",
            tripId
        );


        const response =
            await fetch(
                "/Trip/Update",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/x-www-form-urlencoded; charset=UTF-8"
                    },

                    body:
                        data.toString()
                }
            );


        const result =
            await response.json();


        console.log(
            "Update result:",
            result
        );


        // ==========================================
        // SUCCESS
        // ==========================================

        if (result.success) {

            showMessage(
                "Trip updated successfully.",
                "success"
            );


            if (tripModal) {
                tripModal.classList.remove("show");
            }


            resetTripForm();


            // Reload from SQL Server

            setTimeout(function () {

                window.location.reload();

            }, 700);

        }


        // ==========================================
        // ERROR
        // ==========================================

        else {

            console.error(
                "Update Trip Error:",
                result.error
            );


            showMessage(
                result.message ||
                "Unable to update trip.",
                "error"
            );

        }

    }
    catch (error) {

        console.error(
            "Update Trip Exception:",
            error
        );


        showMessage(
            "Unable to update trip.",
            "error"
        );

    }
    finally {

        saveTripBtn.disabled = false;

        saveTripBtn.innerText =
            "Update Trip";

    }


    return;
}


                                // ==========================================
                                // CREATE NEW TRIP IN DATABASE
                                // ==========================================

                                const data =
                                    new URLSearchParams();


                                data.append(
                                    "pickupLocation",
                                    pickup
                                );

                                data.append(
                                    "destination",
                                    destination
                                );

                                data.append(
                                    "departureTime",
                                    departure
                                );

                                data.append(
                                    "arrivalTime",
                                    arrival
                                );



                                // ==========================================
                                // DISABLE BUTTON
                                // ==========================================

                                saveTripBtn.disabled = true;

                                saveTripBtn.innerText =
                                    "Saving...";


                                try {

                                    console.log(
                                        "Sending Create Trip request..."
                                    );


                                    const response =
                                        await fetch(
                                            "/Trip/Create",
                                            {
                                                method: "POST",

                                                headers: {
                                                    "Content-Type":
                                                        "application/x-www-form-urlencoded; charset=UTF-8"
                                                },

                                                body:
                                                    data.toString()
                                            }
                                        );


                                    console.log(
                                        "Create response:",
                                        response.status
                                    );


                                    const result =
                                        await response.json();


                                    console.log(
                                        "Create result:",
                                        result
                                    );



                                    // ==========================================
                                    // SUCCESS
                                    // ==========================================

                                    if (result.success) {

                                        showMessage(
                                            "Trip created successfully.",
                                            "success"
                                        );


                                        if (tripModal) {
                                            tripModal.classList.remove("show");
                                        }


                                        resetTripForm();


                                        // Reload to get data from SQL Server

                                        setTimeout(function() {

                                            window.location.reload();

                                        }, 700);

                                    }


                                    // ==========================================
                                    // ERROR
                                    // ==========================================

                                    else {

                                        console.error(
                                            "Create Trip Error:",
                                            result.error
                                        );


                                        showMessage(
                                            result.message ||
                                            "Unable to create trip.",
                                            "error"
                                        );

                                    }

                                }
                                catch (error) {

                                    console.error(
                                        "Create Trip Exception:",
                                        error
                                    );


                                    showMessage(
                                        "Unable to create trip.",
                                        "error"
                                    );

                                }
                                finally {

                                    saveTripBtn.disabled = false;

                                    saveTripBtn.innerText =
                                        editMode
                                            ? "Update Trip"
                                            : "Save Trip";

                                }

                            }
                        );

                    }



                    // ==========================================
                    // EDIT & DELETE
                    // ==========================================

                    document.addEventListener(
                        "click",
                        async function(e) {


                            // ==========================================
                            // EDIT BUTTON
                            // ==========================================

                            if (
                                e.target.closest(".edit-btn")
                            ) {

                                const editButton =
                                    e.target.closest(".edit-btn");

                                const row =
                                    editButton.closest("tr");


                                if (!row) {
                                    return;
                                }


                                selectedRow = row;

                                editMode = true;


                                if (tripModalTitle) {

                                    tripModalTitle.innerText =
                                        "Edit Trip";

                                }


                                if (saveTripBtn) {

                                    saveTripBtn.innerText =
                                        "Update Trip";

                                }



                                // Trip Number

                                if (tripNumberInput) {

                                    const title =
                                        row.cells[0]
                                            .querySelector(".data-title");

                                    if (title) {

                                        tripNumberInput.value =
                                            title.innerText.trim();

                                    }
                                    else {

                                        tripNumberInput.value =
                                            row.cells[0]
                                                .innerText
                                                .trim();

                                    }

                                }



                                // Pickup

                                if (pickupLocationInput) {

                                    pickupLocationInput.value =
                                        row.cells[1]
                                            .innerText
                                            .trim();

                                }



                                // Destination

                                if (destinationInput) {

                                    destinationInput.value =
                                        row.cells[2]
                                            .innerText
                                            .trim();

                                }



                                // Departure

                                if (departureTimeInput) {

                                    departureTimeInput.value =
                                        convertTime(
                                            row.cells[3]
                                                .innerText
                                                .trim()
                                        );

                                }



                                // Arrival

                                if (arrivalTimeInput) {

                                    arrivalTimeInput.value =
                                        convertTime(
                                            row.cells[4]
                                                .innerText
                                                .trim()
                                        );

                                }



                                if (tripModal) {

                                    tripModal.classList.add("show");

                                }

                                return;
                            }



                            // ==========================================
                            // DELETE BUTTON
                            // ==========================================

                            if (
                                e.target.closest(".delete-btn")
                            ) {

                                const deleteButton =
                                    e.target.closest(".delete-btn");

                                const row =
                                    deleteButton.closest("tr");


                                if (!row) {
                                    return;
                                }



                                // ==========================================
                                // GET TRIP ID
                                // ==========================================

                                const tripCell =
                                    row.cells[0];

                                let tripText =
                                    tripCell.innerText.trim();


                                /*
                                    Expected:
                                    TR-001
                                    TR-002
                                    TR-005
                                */

                                let tripId =
                                    parseInt(
                                        tripText
                                            .replace("TR-", "")
                                            .trim(),
                                        10
                                    );


                                if (isNaN(tripId)) {

                                    showMessage(
                                        "Invalid Trip ID.",
                                        "error"
                                    );

                                    console.error(
                                        "Could not get TripID from:",
                                        tripText
                                    );

                                    return;
                                }



                                // ==========================================
                                // DELETE CONFIRMATION
                                // ==========================================

                                const confirmed =
                                    window.confirm(
                                        "Are you sure you want to delete this trip?"
                                    );


                                if (!confirmed) {
                                    return;
                                }



                                try {

                                    console.log(
                                        "Deleting Trip:",
                                        tripId
                                    );


                                    const data =
                                        new URLSearchParams();


                                    data.append(
                                        "id",
                                        tripId
                                    );



                                    // ==========================================
                                    // SEND DELETE REQUEST
                                    // ==========================================

                                    const response =
                                        await fetch(
                                            "/Trip/Delete",
                                            {
                                                method: "POST",

                                                headers: {
                                                    "Content-Type":
                                                        "application/x-www-form-urlencoded; charset=UTF-8"
                                                },

                                                body:
                                                    data.toString()
                                            }
                                        );


                                    console.log(
                                        "Delete response:",
                                        response.status
                                    );


                                    const result =
                                        await response.json();


                                    console.log(
                                        "Delete result:",
                                        result
                                    );



                                    // ==========================================
                                    // DELETE SUCCESS
                                    // ==========================================

                                    if (result.success) {

                                        showMessage(
                                            "Trip deleted successfully.",
                                            "success"
                                        );


                                        // Remove from page

                                        row.remove();

                                    }


                                    // ==========================================
                                    // DELETE ERROR
                                    // ==========================================

                                    else {

                                        console.error(
                                            "Delete Trip Error:",
                                            result.error
                                        );


                                        showMessage(
                                            result.message ||
                                            "Unable to delete trip.",
                                            "error"
                                        );

                                    }

                                }
                                catch (error) {

                                    console.error(
                                        "Delete Trip Exception:",
                                        error
                                    );


                                    showMessage(
                                        "Unable to delete trip.",
                                        "error"
                                    );

                                }

                            }

                        }
                    );



                    // ==========================================
                    // LOGOUT
                    // ==========================================

                    const logoutBtn =
                        document.getElementById("logoutBtn");


                    if (logoutBtn) {

                        logoutBtn.addEventListener(
                            "click",
                            function() {

                                window.location.href =
                                    "/";

                            }
                        );

                    }



                    // ==========================================
                    // PREVENT DUPLICATE TRIP NUMBER
                    // ==========================================

                    function tripExists(tripNumber) {

                        if (!tripTableBody) {
                            return false;
                        }


                        const rows =
                            tripTableBody.querySelectorAll("tr");


                        for (let row of rows) {

                            // Ignore row currently being edited

                            if (
                                editMode &&
                                row === selectedRow
                            ) {

                                continue;

                            }


                            const title =
                                row.cells[0]
                                    .querySelector(".data-title");


                            if (!title) {
                                continue;
                            }


                            const currentTrip =
                                title.innerText.trim();


                            if (
                                currentTrip === tripNumber
                            ) {

                                return true;

                            }

                        }


                        return false;

                    }

            </script>



