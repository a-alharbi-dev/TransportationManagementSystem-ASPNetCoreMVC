@model IEnumerable<TransportationManagementSystem.Models.Driver>

@{
    ViewData["Title"] = "Driver Management";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        Driver Management | Transportation Management System
    </title>

    <link href="~/css/styleM.css"
          rel="stylesheet" />

</head>


<body>


<!-- ==========================================
                    HEADER
========================================== -->

<header class="app-header">


    <!-- TOP HEADER -->

    <div class="header-top">

        <div class="container header-top-inner">

            <span>
                King Fahd Armed Forces Hospital in Jeddah
            </span>

            <span>
                Transportation Management System
            </span>

        </div>

    </div>


    <!-- MAIN HEADER -->

    <div class="container header-main-inner">


        <!-- BRAND -->

        <div class="brand">

            <div>

                <h1 class="brand-title">

                    Transportation Management

                </h1>

                <p class="brand-subtitle">

                    Transportation Services Platform

                </p>

            </div>

        </div>


        <!-- NAVIGATION -->

        <nav class="main-nav">


            <a href="/Trip/Index"
               class="nav-link">

                Trip Management

            </a>


            <a href="/Vehicle/Index"
               class="nav-link">

                Vehicle Management

            </a>


            <a href="/Driver/Index"
               class="nav-link active">

                Driver Management

            </a>


        </nav>


        <!-- HEADER ACTIONS -->

        <div class="header-actions">

            <div class="profile-dropdown">


                <button class="manager-chip"
                        id="profileBtn">

                    <span>M</span>

                    <div>

                        <strong>
                            Abrar 
                        </strong>

                    </div>

                </button>


                <div class="profile-menu"
                     id="profileMenu">

                    <button class="menu-item"
                            id="logoutBtn">

                        Sign Out

                    </button>

                </div>


            </div>

        </div>


    </div>

</header>



<!-- ==========================================
                    MAIN
========================================== -->

<main>


<section class="section">


<div class="container">


<div class="card">


    <!-- CARD HEADER -->

    <div class="card-header">

        <div>

            <h2 class="card-title">

                Driver Management

            </h2>


            <p class="section-subtitle">

                Create and manage transportation drivers.

            </p>

        </div>


        <button class="btn btn-primary"
                id="createDriverBtn">

            + Create New Driver

        </button>

    </div>



    <!-- CARD BODY -->

    <div class="card-body">


        <div class="table-responsive">


            <table>


                <thead>

                    <tr>

                        <th>
                            Driver ID
                        </th>

                        <th>
                            Driver Name
                        </th>

                        <th>
                            Phone Number
                        </th>

                        <th>
                            License Number
                        </th>

                        <th>
                            Driver Status
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody id="driverTableBody">


                    @foreach (var driver in Model)
                    {

                        <tr data-id="@driver.DriverID">


                            <!-- DRIVER ID -->

                            <td>

                                <div class="data-title">

                                    DR-@driver.DriverID.ToString("D3")

                                </div>

                            </td>


                            <!-- DRIVER NAME -->

                            <td>

                                @driver.FullName

                            </td>


                            <!-- PHONE -->

                            <td>

                                @driver.Phone

                            </td>


                            <!-- LICENSE -->

                            <td>

                                @driver.LicenseNumber

                            </td>


                            <!-- STATUS -->

                            <td>

                                @driver.Status

                            </td>


                            <!-- ACTIONS -->

                            <td>


                                <button
                                    class="btn btn-secondary edit-btn">

                                    Edit

                                </button>


                                <button
                                    class="btn btn-danger delete-btn">

                                    Delete

                                </button>


                            </td>


                        </tr>

                    }


                </tbody>


            </table>


        </div>


    </div>


</div>


</div>


</section>


</main>



<!-- ==========================================
            CREATE / EDIT DRIVER MODAL
========================================== -->

<div class="modal"
     id="driverModal">


    <div class="modal-dialog">


        <div class="modal-header">


            <h3 class="modal-title"
                id="driverModalTitle">

                Create New Driver

            </h3>


            <button
                class="close-btn"
                id="closeDriverModal">

                ×

            </button>


        </div>



        <div class="modal-body">


            <div class="form-grid">


                <!-- DRIVER NAME -->

                <div class="form-group">


                    <label class="label">

                        Driver Name

                        <span class="required">*</span>

                    </label>


                    <input
                        type="text"
                        class="input"
                        id="driverName"
                        placeholder="Enter driver name">


                </div>



                <!-- PHONE -->

                <div class="form-group">


                    <label class="label">

                        Phone Number

                        <span class="required">*</span>

                    </label>


                    <input
                        type="tel"
                        class="input"
                        id="phoneNumber"
                        placeholder="05XXXXXXXX">


                </div>



                <!-- LICENSE -->

                <div class="form-group">


                    <label class="label">

                        License Number

                        <span class="required">*</span>

                    </label>


                    <input
                        type="text"
                        class="input"
                        id="licenseNumber"
                        placeholder="Enter license number">


                </div>



                <!-- STATUS -->

                <div class="form-group">


                    <label class="label">

                        Driver Status

                        <span class="required">*</span>

                    </label>


                    <select
                        class="select"
                        id="driverStatus">


                        <option value="">

                            Select Status

                        </option>


                        <option value="Available">

                            Available

                        </option>


                        <option value="Off Duty">

                            Off Duty

                        </option>


                    </select>


                </div>


            </div>


        </div>



        <!-- MODAL FOOTER -->

        <div class="modal-footer">


            <button
                class="btn btn-primary"
                id="saveDriverBtn">

                Save Driver

            </button>


            <button
                class="btn btn-secondary"
                id="cancelDriverBtn">

                Cancel

            </button>


        </div>


    </div>

</div>



<!-- ==========================================
                    FOOTER
========================================== -->

<footer class="app-footer">


<div class="container footer-inner">


    <div>


        <h2 class="footer-title">

            Armed Forces Hospital - Jeddah

        </h2>


        <p class="footer-text">

            A sustainable healthy community for Ministry of Defense personnel and their families.

        </p>


        <h2 class="footer-title"
            style="margin-top:15px;">

            Our Mission

        </h2>


        <p class="footer-text">

            Promoting healthy lifestyles and providing integrated preventive and curative healthcare services with professionalism and international quality standards.

        </p>


    </div>



    <div>


        <h2 class="footer-title">

            Transportation

        </h2>


        <ul class="footer-list">


            <li>
                Trip Management
            </li>


            <li>
                Vehicle Management
            </li>


            <li>
                Driver Management
            </li>


        </ul>


    </div>



    <div>


        <h2 class="footer-title">

            Contact Us

        </h2>


        <ul class="footer-list">


            <li>
                Saudi Arabia - Jeddah
            </li>


            <li>
                Corniche Road
            </li>


            <li>
                23311
            </li>


        </ul>


    </div>


</div>



<div class="footer-bottom">


    <div class="container">

        © 2026 Armed Forces Hospital - Jeddah. All Rights Reserved.

    </div>


</div>


</footer>



<!-- ==========================================
                MESSAGE BOX
========================================== -->

<div id="messageBox"
     class="message-box">
</div>



<!-- ==========================================
                    JAVASCRIPT
========================================== -->

<script>


// ==========================================
// MESSAGE BOX
// ==========================================

function showMessage(message, type = "success")
{

    const box =
        document.getElementById("messageBox");


    if (!box)
        return;


    box.className =
        "message-box";


    if (type === "error")
    {

        box.classList.add("error");

    }
    else if (type === "warning")
    {

        box.classList.add("warning");

    }
    else if (type === "info")
    {

        box.classList.add("info");

    }


    box.innerHTML =
        message;


    box.classList.add("show");


    clearTimeout(box.timer);


    box.timer =
        setTimeout(function()
        {

            box.classList.remove("show");

        }, 3000);

}



// ==========================================
// PROFILE MENU
// ==========================================

const profileBtn =
    document.getElementById("profileBtn");


const profileMenu =
    document.getElementById("profileMenu");


if (profileBtn && profileMenu)
{

    profileBtn.addEventListener(
        "click",
        function(e)
        {

            e.stopPropagation();

            profileMenu.classList.toggle("show");

        });


    document.addEventListener(
        "click",
        function()
        {

            profileMenu.classList.remove("show");

        });

}



// ==========================================
// VARIABLES
// ==========================================

const driverModal =
    document.getElementById("driverModal");


const createDriverBtn =
    document.getElementById("createDriverBtn");


const closeDriverModal =
    document.getElementById("closeDriverModal");


const cancelDriverBtn =
    document.getElementById("cancelDriverBtn");


const saveDriverBtn =
    document.getElementById("saveDriverBtn");


const driverModalTitle =
    document.getElementById("driverModalTitle");


const driverTableBody =
    document.getElementById("driverTableBody");


let editMode =
    false;


let selectedRow =
    null;



// ==========================================
// CLEAR FORM
// ==========================================

function clearForm()
{

    document.getElementById(
        "driverName"
    ).value = "";


    document.getElementById(
        "phoneNumber"
    ).value = "";


    document.getElementById(
        "licenseNumber"
    ).value = "";


    document.getElementById(
        "driverStatus"
    ).selectedIndex = 0;

}



// ==========================================
// OPEN CREATE MODAL
// ==========================================

if (createDriverBtn)
{

    createDriverBtn.addEventListener(
        "click",
        function()
        {

            editMode =
                false;


            selectedRow =
                null;


            driverModalTitle.innerText =
                "Create New Driver";


            saveDriverBtn.innerText =
                "Save Driver";


            clearForm();


            driverModal.classList.add(
                "show"
            );

        });

}



// ==========================================
// CLOSE MODAL
// ==========================================

if (closeDriverModal)
{

    closeDriverModal.addEventListener(
        "click",
        function()
        {

            driverModal.classList.remove(
                "show"
            );

        });

}



if (cancelDriverBtn)
{

    cancelDriverBtn.addEventListener(
        "click",
        function()
        {

            driverModal.classList.remove(
                "show"
            );

        });

}



// ==========================================
// SAVE DRIVER
// CREATE + UPDATE
// ==========================================

if (saveDriverBtn)
{

    saveDriverBtn.addEventListener(
        "click",
        async function()
        {


            const name =
                document.getElementById(
                    "driverName"
                ).value.trim();


            const phone =
                document.getElementById(
                    "phoneNumber"
                ).value.trim();


            const license =
                document.getElementById(
                    "licenseNumber"
                ).value.trim();


            const status =
                document.getElementById(
                    "driverStatus"
                ).value;



            // ==========================================
            // VALIDATION
            // ==========================================

            if (
                name === "" ||
                phone === "" ||
                license === "" ||
                status === ""
            )
            {

                showMessage(
                    "Please complete all required fields.",
                    "warning"
                );


                return;

            }



            // ==========================================
            // UPDATE DRIVER
            // ==========================================

            if (
                editMode &&
                selectedRow
            )
            {


                const driverID =
                    selectedRow.getAttribute(
                        "data-id"
                    );


                if (!driverID)
                {

                    showMessage(
                        "Driver ID not found.",
                        "error"
                    );


                    return;

                }



                try
                {


                    const response =
                        await fetch(
                            "/Driver/Update",
                            {

                                method: "POST",

                                headers:
                                {
                                    "Content-Type":
                                        "application/x-www-form-urlencoded"
                                },

                                body:
                                    "driverID=" +
                                    encodeURIComponent(
                                        driverID
                                    ) +

                                    "&fullName=" +
                                    encodeURIComponent(
                                        name
                                    ) +

                                    "&phone=" +
                                    encodeURIComponent(
                                        phone
                                    ) +

                                    "&licenseNumber=" +
                                    encodeURIComponent(
                                        license
                                    ) +

                                    "&status=" +
                                    encodeURIComponent(
                                        status
                                    )

                            }
                        );



                    const result =
                        await response.json();



                    if (!result.success)
                    {

                        showMessage(
                            result.message ||
                            "Unable to update driver.",
                            "error"
                        );


                        return;

                    }



                    // UPDATE TABLE

                    selectedRow.cells[1]
                        .innerText =
                        name;


                    selectedRow.cells[2]
                        .innerText =
                        phone;


                    selectedRow.cells[3]
                        .innerText =
                        license;


                    selectedRow.cells[4]
                        .innerText =
                        status;



                    showMessage(
                        "Driver updated successfully."
                    );


                    editMode =
                        false;


                    selectedRow =
                        null;


                    driverModal.classList.remove(
                        "show"
                    );


                    clearForm();

                }
                catch (error)
                {

                    console.error(error);


                    showMessage(
                        "Unable to update driver.",
                        "error"
                    );

                }


                return;

            }



            // ==========================================
            // CREATE DRIVER
            // ==========================================

            try
            {


                const response =
                    await fetch(
                        "/Driver/Create",
                        {

                            method: "POST",

                            headers:
                            {
                                "Content-Type":
                                    "application/x-www-form-urlencoded"
                            },


                            body:
                                "fullName=" +
                                encodeURIComponent(
                                    name
                                ) +

                                "&phone=" +
                                encodeURIComponent(
                                    phone
                                ) +

                                "&licenseNumber=" +
                                encodeURIComponent(
                                    license
                                ) +

                                "&status=" +
                                encodeURIComponent(
                                    status
                                )

                        }
                    );



                const result =
                    await response.json();



                if (!result.success)
                {

                    showMessage(
                        result.message ||
                        "Unable to create driver.",
                        "error"
                    );


                    return;

                }



                // ==========================================
                // ADD NEW ROW
                // ==========================================

                const row =
                    document.createElement(
                        "tr"
                    );


                row.setAttribute(
                    "data-id",
                    result.driverId
                );


                row.innerHTML = `

                    <td>

                        <div class="data-title">

                            DR-${String(
                                result.driverId
                            ).padStart(3, "0")}

                        </div>

                    </td>


                    <td>

                        ${name}

                    </td>


                    <td>

                        ${phone}

                    </td>


                    <td>

                        ${license}

                    </td>


                    <td>

                        ${status}

                    </td>


                    <td>


                        <button
                            class="btn btn-secondary edit-btn">

                            Edit

                        </button>


                        <button
                            class="btn btn-danger delete-btn">

                            Delete

                        </button>


                    </td>

                `;


                driverTableBody.appendChild(
                    row
                );



                showMessage(
                    "Driver created successfully."
                );



                editMode =
                    false;


                selectedRow =
                    null;


                driverModal.classList.remove(
                    "show"
                );


                clearForm();

            }
            catch (error)
            {

                console.error(error);


                showMessage(
                    "Unable to create driver.",
                    "error"
                );

            }

        });

}



// ==========================================
// EDIT + DELETE
// ==========================================

document.addEventListener(
    "click",
    async function(e)
    {


        // ==========================================
        // EDIT
        // ==========================================

        if (
            e.target.classList.contains(
                "edit-btn"
            )
        )
        {


            selectedRow =
                e.target.closest(
                    "tr"
                );


            if (!selectedRow)
                return;


            editMode =
                true;


            driverModalTitle.innerText =
                "Edit Driver";


            saveDriverBtn.innerText =
                "Update Driver";



            // Driver Name

            document.getElementById(
                "driverName"
            ).value =
                selectedRow.cells[1]
                    .innerText
                    .trim();



            // Phone

            document.getElementById(
                "phoneNumber"
            ).value =
                selectedRow.cells[2]
                    .innerText
                    .trim();



            // License

            document.getElementById(
                "licenseNumber"
            ).value =
                selectedRow.cells[3]
                    .innerText
                    .trim();



            // Status

            document.getElementById(
                "driverStatus"
            ).value =
                selectedRow.cells[4]
                    .innerText
                    .trim();



            driverModal.classList.add(
                "show"
            );


            return;

        }



        // ==========================================
        // DELETE
        // ==========================================

        if (
            e.target.classList.contains(
                "delete-btn"
            )
        )
        {


            const row =
                e.target.closest(
                    "tr"
                );


            if (!row)
                return;


            const driverID =
                row.getAttribute(
                    "data-id"
                );


            if (!driverID)
            {

                showMessage(
                    "Driver ID not found.",
                    "error"
                );


                return;

            }



            try
            {


                const response =
                    await fetch(
                        "/Driver/Delete",
                        {

                            method: "POST",

                            headers:
                            {
                                "Content-Type":
                                    "application/x-www-form-urlencoded"
                            },


                            body:
                                "id=" +
                                encodeURIComponent(
                                    driverID
                                )

                        }
                    );



                const result =
                    await response.json();



                if (!result.success)
                {

                    showMessage(
                        result.message ||
                        "Unable to delete driver.",
                        "error"
                    );


                    return;

                }



                row.remove();


                showMessage(
                    "Driver deleted successfully.",
                    "success"
                );

            }
            catch (error)
            {

                console.error(error);


                showMessage(
                    "Unable to delete driver.",
                    "error"
                );

            }

        }

    }
);



// ==========================================
// CLOSE MODAL WHEN CLICKING OUTSIDE
// ==========================================

window.addEventListener(
    "click",
    function(e)
    {

        if (
            e.target ===
            driverModal
        )
        {

            driverModal.classList.remove(
                "show"
            );

        }

    }
);



// ==========================================
// LOGOUT
// ==========================================

const logoutBtn =
    document.getElementById(
        "logoutBtn"
    );


if (logoutBtn)
{

    logoutBtn.addEventListener(
        "click",
        function()
        {

        window.location.href =
            "/Login/Index";

        }
    );

}

</script>


</body>

</html>
