@model IEnumerable<TransportationManagementSystem.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        Transportation Management System
    </title>

    <!-- Your existing CSS -->
    <link href="~/css/styleA.css" rel="stylesheet" />

</head>

<body>

    <!-- ==========================================
                         HEADER
    =========================================== -->

    <header class="app-header">

        <div class="header-top">

            <div class="container header-top-inner">

                <span>
                    King Fahd Armed Forces Hospital in Jeddah
                </span>

                <span>
                    Transportation Management System
                </span>

            </div>

        </div>


        <div class="container header-main-inner">

            <!-- Brand -->

            <div class="brand">

                <div>

                    <h1 class="brand-title">
                        Transportation Management
                    </h1>

                    <p class="brand-subtitle">
                        Transportation Services Platform
                    </p>

                </div>

            </div>


            <!-- Navigation -->

            <nav class="main-nav">





                <a href="/EmergencyRequest/Create"
                   class="nav-link">

                    Emergency Request

                </a>


                <a href="/Notification/Index"
                   class="nav-link active">

                    Notifications

                </a>

            </nav>


            <!-- Actions -->

            <div class="header-actions">

                <!-- User -->

                <div class="profile-dropdown">

                    <button class="manager-chip"
                            id="profileBtn"
                            type="button">

                        <span>A</span>

                        <div>

                            <strong>Abrar Alharbi</strong>

                            <br>

                            <small>
                                nurse 
                            </small>

                        </div>

                    </button>


                    <div class="profile-menu"
                         id="profileMenu">

 


                        <button class="menu-item"
                                id="logoutBtn"
                                type="button">

                            Sign Out

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </header>




<!-- ==========================================
             NOTIFICATION DETAILS MODAL
=========================================== -->

<div id="notificationModal"
     class="modal">

    <div class="modal-dialog">

        <div class="modal-header">

            <div>

                <h3 class="modal-title">
                    Notification Details
                </h3>

                <p class="section-subtitle">
                    View notification information.
                </p>

            </div>

            <button type="button"
                    class="modal-close"
                    id="closeNotificationModal">

                &times;

            </button>

        </div>


        <div class="modal-body">

            <!-- Notification ID -->

            <div class="notification-detail-row">

                <span class="notification-detail-label">
                    Notification ID
                </span>

                <span class="notification-detail-value"
                      id="notificationId">

                    -

                </span>

            </div>


            <!-- Message -->

            <div class="notification-detail-row">

                <span class="notification-detail-label">
                    Message
                </span>

                <span class="notification-detail-value"
                      id="notificationMessage">

                    -

                </span>

            </div>


            <!-- Date -->

            <div class="notification-detail-row">

                <span class="notification-detail-label">
                    Date
                </span>

                <span class="notification-detail-value"
                      id="notificationDate">

                    -

                </span>

            </div>


            <!-- Time -->

            <div class="notification-detail-row">

                <span class="notification-detail-label">
                    Time
                </span>

                <span class="notification-detail-value"
                      id="notificationTime">

                    -

                </span>

            </div>


            <!-- Status -->

            <div class="notification-detail-row">

                <span class="notification-detail-label">
                    Status
                </span>

                <span class="notification-detail-value">

                    <span class="badge"
                          id="notificationStatus">

                        -

                    </span>

                </span>

            </div>

        </div>


        <div class="modal-footer">

            <button type="button"
                    class="btn btn-neutral"
                    id="closeNotificationButton">

                Close

            </button>

        </div>

    </div>

</div>


<!-- Anti Forgery Token -->

<form id="notificationAntiForgeryForm"
      style="display:none;">

    @Html.AntiForgeryToken()

</form>

    <!-- ==========================================
                         MAIN
    =========================================== -->

    <main>

        <div class="container">


            <!-- ==========================================
                        NOTIFICATIONS
            =========================================== -->

            <section class="section">

                <div class="card">


                    <!-- Header -->

                    <div class="card-header">

                        <div>

                            <h3 class="card-title">
                                Notifications
                            </h3>


                            <p class="section-subtitle">
                                View all recent transportation notifications.
                            </p>

                        </div>

                    </div>


                    <!-- Body -->

                    <div class="card-body">


                        <!-- Filter -->

                        <div class="table-tools">

                            <div>

                                <label class="label"
                                       for="filter">

                                    Show

                                </label>


                                <select class="select"
                                        id="filter">

                                    <option value="Latest Notifications">
                                        Latest Notifications
                                    </option>

                                    <option value="All Notifications">
                                        All Notifications
                                    </option>

                                    <option value="Unread Notifications">
                                        Unread Notifications
                                    </option>

                                </select>

                            </div>

                        </div>


                        <!-- ==========================================
                            NOTIFICATIONS TABLE
                        =========================================== -->

                        <div class="table-responsive">

                            <table>

                                <thead>

                                    <tr>

                                        <th>
                                            Notification
                                        </th>

                                        <th>
                                            Date
                                        </th>

                                        <th>
                                            Status
                                        </th>

                                    </tr>

                                </thead>


                                <tbody id="notificationTableBody">

                                    @if (Model != null && Model.Any())
                                    {

                                        foreach (var notification in Model)
                                        {

                                            var statusClass = "badge-info";

                                            if (notification.Status == "New")
                                            {
                                                statusClass = "badge-success";
                                            }
                                            else if (notification.Status == "Important")
                                            {
                                                statusClass = "badge-warning";
                                            }
                                            else if (notification.Status == "Updated")
                                            {
                                                statusClass = "badge-info";
                                            }
                                            else if (notification.Status == "Received")
                                            {
                                                statusClass = "badge-success";
                                            }


                                       <tr class="notification-row"
    data-id="@notification.NotificationID"
    data-message="@notification.Message"
    data-date="@notification.CreatedAt.ToString("dd/MM/yyyy")"
    data-time="@notification.CreatedAt.ToString("hh:mm tt")"
    data-status="@notification.Status">

    <td>

        @notification.Message

    </td>


    <td>

        @notification.CreatedAt.ToString("dd/MM/yyyy")

    </td>


    <td>

        <span class="badge @statusClass notification-status-badge">

            @notification.Status

        </span>

    </td>

</tr>


                                        }

                                    }
                                    else
                                    {

                                        <tr id="noNotificationsRow">

                                            <td colspan="3"
                                                style="text-align:center; padding:30px;">

                                                No notifications available.

                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </section>

        </div>

    </main>


    <!-- ==========================================
                    HOSPITAL FOOTER
    =========================================== -->

    <footer class="app-footer">

        <div class="container footer-inner">


            <!-- INFORMATION -->

            <div>

                <h2 class="footer-title">
                    Armed Forces Hospital - Jeddah
                </h2>


                <p class="footer-text">

                    A sustainable healthy community for Ministry of Defense personnel and their families.

                </p>


                <h2 class="footer-title"
                    style="margin-top:15px;">

                    Our Mission

                </h2>


                <p class="footer-text">

                    Promoting healthy lifestyles and providing integrated preventive and curative healthcare services with professionalism and international quality standards.

                </p>

            </div>


            <!-- SYSTEM INFO -->

            <div>

                <h2 class="footer-title">
                    Transportation
                </h2>


                <ul class="footer-list">

                    <li>
                        My Trips
                    </li>

                    <li>
                        My Schedule
                    </li>

                    <li>
                        Manage Trips
                    </li>

                    <li>
                        Emergency Requests
                    </li>

                </ul>

            </div>


            <!-- CONTACT -->

            <div>

                <h2 class="footer-title">
                    Contact Us
                </h2>


                <ul class="footer-list">

                    <li>
                        Saudi Arabia - Jeddah
                    </li>

                    <li>
                        Corniche Road
                    </li>

                    <li>
                        Al Andalus
                    </li>

                    <li>
                        23311
                    </li>

                </ul>

            </div>

        </div>


        <div class="footer-bottom">

            <div class="container">

                © 2026 Armed Forces Hospital - Jeddah.
                All Rights Reserved.

            </div>

        </div>

    </footer>


    <!-- ==========================================
                         JAVASCRIPT
    =========================================== -->

    <script>

        // ==========================================
        // Profile Dropdown
        // ==========================================

        const profileBtn =
            document.getElementById("profileBtn");

        const profileMenu =
            document.getElementById("profileMenu");


        if (profileBtn && profileMenu) {

            profileBtn.addEventListener("click", function (e) {

                e.stopPropagation();

                profileMenu.classList.toggle("show");

            });


            document.addEventListener("click", function () {

                profileMenu.classList.remove("show");

            });

        }


        // ==========================================
        // Location Modal
        // ==========================================

        const locationBtn =
            document.getElementById("locationBtn");

        const locationModal =
            document.getElementById("locationModal");

        const saveLocation =
            document.getElementById("saveLocation");

        const cancelLocation =
            document.getElementById("cancelLocation");

        const locationSelect =
            document.getElementById("locationSelect");


        if (locationBtn) {

            locationBtn.addEventListener("click", function () {

                if (locationModal) {

                    locationModal.style.display = "flex";

                }

                if (profileMenu) {

                    profileMenu.classList.remove("show");

                }

            });

        }


        if (cancelLocation) {

            cancelLocation.addEventListener("click", function () {

                if (locationModal) {

                    locationModal.style.display = "none";

                }

            });

        }


        if (saveLocation) {

            saveLocation.addEventListener("click", function () {

                if (locationModal) {

                    locationModal.style.display = "none";

                }

            });

        }


        window.addEventListener("click", function (e) {

            if (e.target === locationModal) {

                locationModal.style.display = "none";

            }

        });


        // ==========================================
        // Logout
        // ==========================================

        const logoutBtn =
            document.getElementById("logoutBtn");


        if (logoutBtn) {

            logoutBtn.addEventListener("click", function () {

                const confirmed =
                    confirm("Are you sure you want to sign out?");

                if (confirmed) {

                    window.location.href = "/Login/Index";

                }

            });

        }


        // ==========================================
        // Notification Filter
        // ==========================================

        const filter =
            document.getElementById("filter");

        const tableBody =
            document.getElementById("notificationTableBody");


        if (filter && tableBody) {

            filter.addEventListener("change", function () {

                const value = this.value;

                const rows =
                    tableBody.querySelectorAll("tr");


                rows.forEach(function (row) {

                    // Don't hide the empty notification message
                    if (row.id === "noNotificationsRow") {

                        return;

                    }


                    const badge =
                        row.querySelector(".badge");


                    if (!badge) {

                        return;

                    }


                    const status =
                        badge.textContent.trim();


                    // ==========================
                    // ALL NOTIFICATIONS
                    // ==========================

                    if (value === "All Notifications") {

                        row.style.display = "";

                    }


                    // ==========================
                    // LATEST NOTIFICATIONS
                    // ==========================

                    else if (value === "Latest Notifications") {

                        // Show all database notifications.
                        // They are already ordered newest first
                        // by the NotificationController.

                        row.style.display = "";

                    }


                    // ==========================
                    // UNREAD NOTIFICATIONS
                    // ==========================

                    else if (value === "Unread Notifications") {

                        if (status === "New") {

                            row.style.display = "";

                        }
                        else {

                            row.style.display = "none";

                        }

                    }

                });

            });

        }

        // ==========================================
// Notification Details Modal
// ==========================================

const notificationModal =
    document.getElementById("notificationModal");

const closeNotificationModal =
    document.getElementById("closeNotificationModal");

const closeNotificationButton =
    document.getElementById("closeNotificationButton");


// Notification detail fields

const notificationId =
    document.getElementById("notificationId");

const notificationMessage =
    document.getElementById("notificationMessage");

const notificationDate =
    document.getElementById("notificationDate");

const notificationTime =
    document.getElementById("notificationTime");

const notificationStatus =
    document.getElementById("notificationStatus");


// Anti-forgery token

const antiForgeryToken =
    document.querySelector(
        '#notificationAntiForgeryForm input[name="__RequestVerificationToken"]'
    );


// ==========================================
// OPEN NOTIFICATION
// ==========================================

const notificationRows =
    document.querySelectorAll(".notification-row");


notificationRows.forEach(function (row) {

    row.addEventListener("click", async function () {

        // ==========================================
        // GET NOTIFICATION DATA
        // ==========================================

        const id =
            row.dataset.id;

        const message =
            row.dataset.message;

        const date =
            row.dataset.date;

        const time =
            row.dataset.time;

        let status =
            row.dataset.status;


        // ==========================================
        // PUT DATA INSIDE MODAL
        // ==========================================

        notificationId.textContent =
            id;

        notificationMessage.textContent =
            message;

        notificationDate.textContent =
            date;

        notificationTime.textContent =
            time;

        notificationStatus.textContent =
            status;


        // ==========================================
        // SHOW MODAL
        // ==========================================

        notificationModal.style.display =
            "flex";


        // ==========================================
        // IF NEW -> MARK AS READ
        // ==========================================

        if (status === "New") {

            try {

                const formData =
                    new FormData();

                formData.append(
                    "id",
                    id
                );

                formData.append(
                    "__RequestVerificationToken",
                    antiForgeryToken.value
                );


                const response =
                    await fetch(
                        "/Notification/MarkAsRead",
                        {
                            method: "POST",
                            body: formData
                        }
                    );


                if (response.ok) {

                    const result =
                        await response.json();


                    if (result.success) {

                        // ==================================
                        // CHANGE ROW STATUS
                        // ==================================

                        const badge =
                            row.querySelector(
                                ".notification-status-badge"
                            );


                        if (badge) {

                            badge.textContent =
                                "Read";


                            // Remove old status classes

                            badge.classList.remove(
                                "badge-success",
                                "badge-warning",
                                "badge-info"
                            );


                            // Add Read style

                            badge.classList.add(
                                "badge-info"
                            );

                        }


                        // ==================================
                        // UPDATE DATA
                        // ==================================

                        row.dataset.status =
                            "Read";


                        status =
                            "Read";


                        // ==================================
                        // UPDATE MODAL
                        // ==================================

                        notificationStatus.textContent =
                            "Read";

                    }

                }

            }
            catch (error) {

                console.error(
                    "Error marking notification as read:",
                    error
                );

            }

        }

    });

});


// ==========================================
// CLOSE MODAL
// ==========================================

if (closeNotificationModal) {

    closeNotificationModal.addEventListener(
        "click",
        function () {

            notificationModal.style.display =
                "none";

        }
    );

}


if (closeNotificationButton) {

    closeNotificationButton.addEventListener(
        "click",
        function () {

            notificationModal.style.display =
                "none";

        }
    );

}


// ==========================================
// CLOSE WHEN CLICKING OUTSIDE
// ==========================================

window.addEventListener(
    "click",
    function (event) {

        if (event.target === notificationModal) {

            notificationModal.style.display =
                "none";

        }

    }
);

    </script>

</body>

</html>