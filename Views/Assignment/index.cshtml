@model IEnumerable<TransportationManagementSystem.Models.Assignment>

@{
    ViewData["Title"] = "Assignment Management";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        Assignment Management | Transportation Management System
    </title>

    <link href="~/css/styleA.css"
          rel="stylesheet" />

</head>


<body>


    <!-- =========================================================
                         HEADER
========================================================= -->

    <header class="app-header">


        <!-- TOP HEADER -->

        <div class="header-top">

            <div class="container header-top-inner">

                <span>
                    King Fahd Armed Forces Hospital in Jeddah
                </span>

                <span>
                    Transportation Management System
                </span>

            </div>

        </div>


        <!-- MAIN HEADER -->

        <div class="container header-main-inner">


            <!-- BRAND -->

            <div class="brand">




                <div>

                    <h1 class="brand-title">

                        Movement Officer

                    </h1>


                    <p class="brand-subtitle">

                        Transportation Services Platform

                    </p>

                </div>

            </div>


            <!-- NAVIGATION -->

            <nav class="main-nav">


                <a href="/Assignment/Index"
                   class="nav-link active">

                    Assignment Management

                </a>

        
<a href="/EmergencyRequests/Index"
   class="nav-link ">

    Emergency Requests

</a>


            </nav>


            <!-- PROFILE -->

            <div class="header-actions">

                <div class="profile-dropdown">


                    <button class="manager-chip"
                            id="profileBtn">

                        <span>
                            MO
                        </span>


                        <div>

                            <strong>
                                Movement Officer
                            </strong>

                        </div>

                    </button>


                    <div class="profile-menu"
                         id="profileMenu">


                        <button class="menu-item"
                                id="logoutBtn">

                            Sign Out

                        </button>


                    </div>

                </div>

            </div>


        </div>

    </header>


    <!-- =========================================================
                           MAIN
========================================================= -->

    <main>


        <section class="section">


            <div class="container">


                <div class="card">


                    <!-- CARD HEADER -->

                    <div class="card-header">


                        <div>

                            <h2 class="card-title">

                                Assignment Management

                            </h2>


                            <p class="section-subtitle">

                                Create and manage trip assignments.

                            </p>

                        </div>


                        <button class="btn btn-primary"
                                id="createAssignmentBtn">

                            + Create New Assignment

                        </button>


                    </div>


                    <!-- CARD BODY -->

                    <div class="card-body">


                        <!-- TOOLBAR -->

                        <div class="toolbar-card">


                            <input type="search"
                                   class="input"
                                   id="assignmentSearch"
                                   placeholder="Search assignment, trip, driver or vehicle">


                            <select class="select"
                                    id="statusFilter">

                                <option value="all">

                                    All Status

                                </option>


                                <option value="Assigned">

                                    Assigned

                                </option>


                                <option value="Completed">

                                    Completed

                                </option>


                                <option value="Cancelled">

                                    Cancelled

                                </option>

                            </select>


                        </div>


                        <!-- TABLE -->

                        <div class="table-responsive">


                            <table>


                                <thead>


                                    <tr>


                                        <th>
                                            Assignment ID
                                        </th>


                                        <th>
                                            Trip
                                        </th>


                                        <th>
                                            Driver
                                        </th>


                                        <th>
                                            Vehicle
                                        </th>


                                        <th>
                                            Assigned Date
                                        </th>


                                        <th>
                                            Status
                                        </th>


                                        <th>
                                            Actions
                                        </th>


                                    </tr>


                                </thead>


                                <tbody id="assignmentTableBody">


                                    @foreach (var assignment in Model)
                                    {


                                        <tr data-id="@assignment.AssignmentID"
                                            data-trip-id="@assignment.TripID"
                                            data-driver-id="@assignment.DriverID"
                                            data-vehicle-id="@assignment.VehicleID"
                                            data-assigned-date="@assignment.AssignedDate.ToString("yyyy-MM-dd")"
                                            data-status="@assignment.Status">


                                            <!-- ASSIGNMENT ID -->

                                            <td>


                                                <div class="data-title">

                                                    AS-@assignment.AssignmentID.ToString("D3")

                                                </div>


                                            </td>


                                            <!-- TRIP -->

                                            <td>

                                                Trip #@assignment.TripID

                                            </td>


                                            <!-- DRIVER -->

                                            <td>


                                                @if (assignment.Driver != null)
                                                {

                                                    @assignment.Driver.FullName

                                                }
                                                else
                                                {

                                                    <span>
                                                        Driver #@assignment.DriverID
                                                    </span>

                                                }


                                            </td>


                                            <!-- VEHICLE -->

                                            <td>


                                                @if (assignment.Vehicle != null)
                                                {

                                                    @assignment.Vehicle.PlateNumber

                                                }
                                                else
                                                {

                                                    <span>
                                                        Vehicle #@assignment.VehicleID
                                                    </span>

                                                }


                                            </td>


                                            <!-- ASSIGNED DATE -->

                                            <td>

                                                @assignment.AssignedDate.ToString("yyyy-MM-dd")

                                            </td>


                                            <!-- STATUS -->

                                            <td>

                                                @assignment.Status

                                            </td>


                                            <!-- ACTIONS -->

                                            <td>


                                                <button class="btn btn-secondary edit-btn">

                                                    Edit

                                                </button>


                                                <button class="btn btn-danger delete-btn">

                                                    Delete

                                                </button>


                                            </td>


                                        </tr>


                                    }


                                </tbody>


                            </table>


                        </div>


                    </div>


                </div>


            </div>


        </section>


    </main>


    <!-- =========================================================
                           FOOTER
========================================================= -->

    <footer class="app-footer">


        <div class="container footer-inner">


            <div>


                <h2 class="footer-title">

                    Armed Forces Hospital - Jeddah

                </h2>


                <p class="footer-text">

                    A sustainable healthy community for Ministry of Defense personnel and their families.

                </p>


                <h2 class="footer-title"
                    style="margin-top:15px;">

                    Our Mission

                </h2>


                <p class="footer-text">

                    Promoting healthy lifestyles and providing integrated preventive and curative healthcare services with professionalism and international quality standards.

                </p>


            </div>


            <div>


                <h2 class="footer-title">

                    Transportation

                </h2>


                <ul class="footer-list">


                    <li>
                        Assignment Management
                    </li>


                    <li>
                        Emergency Requests
                    </li>


                </ul>


            </div>


            <div>


                <h2 class="footer-title">

                    Contact Us

                </h2>


                <ul class="footer-list">


                    <li>
                        Saudi Arabia - Jeddah
                    </li>


                    <li>
                        Corniche Road
                    </li>


                    <li>
                        23311
                    </li>


                </ul>


            </div>


        </div>


        <div class="footer-bottom">


            <div class="container">

                © 2026 Armed Forces Hospital - Jeddah.
                All Rights Reserved.

            </div>


        </div>


    </footer>


    <!-- =========================================================
                    CREATE / EDIT MODAL
========================================================= -->

    <div class="modal"
         id="assignmentModal">


        <div class="modal-dialog">


            <div class="modal-header">


                <h3 class="modal-title"
                    id="assignmentModalTitle">

                    Create New Assignment

                </h3>


                <button class="close-btn"
                        id="closeAssignmentModal">

                    ×

                </button>


            </div>


            <div class="modal-body">


                <div class="form-grid">


                    <!-- TRIP -->

                    <div class="form-group">


                        <label class="label">

                            Trip

                            <span class="required">
                                *
                            </span>

                        </label>


                        <select class="select"
                                id="tripID">


                            <option value="">

                                Select Trip

                            </option>


                            @foreach (var trip in ViewBag.Trips)
                            {
                                <option value="@trip.TripID">
                                    Trip #@trip.TripID -
                                    @trip.PickupLocation →
                                    @trip.Destination
                                </option>
                            }


                        </select>


                    </div>


                    <!-- DRIVER -->

                    <div class="form-group">


                        <label class="label">

                            Driver

                            <span class="required">
                                *
                            </span>

                        </label>


                        <select class="select"
                                id="driverID">


                            <option value="">

                                Select Driver

                            </option>


                            @foreach (var driver in ViewBag.Drivers)
                            {

                                <option value="@driver.DriverID">

                                    @driver.FullName

                                </option>

                            }


                        </select>


                    </div>


                    <!-- VEHICLE -->

                    <div class="form-group">


                        <label class="label">

                            Vehicle

                            <span class="required">
                                *
                            </span>

                        </label>


                        <select class="select"
                                id="vehicleID">


                            <option value="">

                                Select Vehicle

                            </option>


                            @foreach (var vehicle in ViewBag.Vehicles)
                            {

                                <option value="@vehicle.VehicleID">

                                    @vehicle.PlateNumber

                                </option>

                            }


                        </select>


                    </div>


                    <!-- ASSIGNED DATE -->

                    <div class="form-group">


                        <label class="label">

                            Assigned Date

                            <span class="required">
                                *
                            </span>

                        </label>


                        <input type="date"
                               class="input"
                               id="assignedDate">


                    </div>


                    <!-- STATUS -->

                    <div class="form-group full">


                        <label class="label">

                            Status

                            <span class="required">
                                *
                            </span>

                        </label>


                        <select class="select"
                                id="assignmentStatus">


                            <option value="">

                                Select Status

                            </option>


                            <option value="Assigned">

                                Assigned

                            </option>


                            <option value="Completed">

                                Completed

                            </option>


                            <option value="Cancelled">

                                Cancelled

                            </option>


                        </select>


                    </div>


                </div>


            </div>


            <div class="modal-footer">


                <button class="btn btn-primary"
                        id="saveAssignmentBtn">

                    Save Assignment

                </button>


                <button class="btn btn-secondary"
                        id="cancelAssignmentBtn">

                    Cancel

                </button>


            </div>


        </div>


    </div>


    <!-- =========================================================
                       MESSAGE BOX
========================================================= -->

    <div id="messageBox"
         class="message-box">
    </div>


    <!-- =========================================================
                           SCRIPT
========================================================= -->

    <script>


            // =========================================================
            // MESSAGE
            // =========================================================

            function showMessage(message, type = "success") {

                const box =
                    document.getElementById("messageBox");


                box.className =
                    "message-box";


                if (type === "error") {
                    box.classList.add("error");
                }


                if (type === "warning") {
                    box.classList.add("warning");
                }


                if (type === "info") {
                    box.classList.add("info");
                }


                box.innerHTML =
                    message;


                box.classList.add("show");


                clearTimeout(box.timer);


                box.timer =
                    setTimeout(function() {
                        box.classList.remove("show");

                    }, 3000);

            }



            // =========================================================
            // PROFILE
            // =========================================================

            const profileBtn =
                document.getElementById("profileBtn");


            const profileMenu =
                document.getElementById("profileMenu");


            if (profileBtn && profileMenu) {

                profileBtn.addEventListener(
                    "click",
                    function(e) {
                        e.stopPropagation();

                        profileMenu.classList.toggle("show");
                    }
                );


                document.addEventListener(
                    "click",
                    function() {
                        profileMenu.classList.remove("show");
                    }
                );

            }



            // =========================================================
            // VARIABLES
            // =========================================================

            const assignmentModal =
                document.getElementById("assignmentModal");


            const createAssignmentBtn =
                document.getElementById("createAssignmentBtn");


            const closeAssignmentModal =
                document.getElementById("closeAssignmentModal");


            const cancelAssignmentBtn =
                document.getElementById("cancelAssignmentBtn");


            const saveAssignmentBtn =
                document.getElementById("saveAssignmentBtn");


            const assignmentModalTitle =
                document.getElementById("assignmentModalTitle");


            let editMode = false;


            let selectedRow = null;

            // =========================================================
// LOAD AVAILABLE TRIPS
// =========================================================

async function loadAvailableTrips()
{
    try
    {
        const response =
            await fetch(
                "/Assignment/GetAvailableTrips"
            );


        if (!response.ok)
        {
            throw new Error(
                "Unable to load trips."
            );
        }


        const trips =
            await response.json();


        const tripSelect =
            document.getElementById(
                "tripID"
            );


        if (!tripSelect)
            return;


        // =====================================================
        // CLEAR OLD OPTIONS
        // =====================================================

        tripSelect.innerHTML = "";


        // =====================================================
        // DEFAULT OPTION
        // =====================================================

        const defaultOption =
            document.createElement(
                "option"
            );


        defaultOption.value =
            "";


        defaultOption.textContent =
            "Select Trip";


        tripSelect.appendChild(
            defaultOption
        );


        // =====================================================
        // ADD AVAILABLE TRIPS
        // =====================================================

        trips.forEach(
            function(trip)
            {
                const option =
                    document.createElement(
                        "option"
                    );


                option.value =
                    trip.tripID;


                option.textContent =
                    "Trip #" +
                    trip.tripID +
                    " - " +
                    trip.pickupLocation +
                    " → " +
                    trip.destination;


                tripSelect.appendChild(
                    option
                );
            }
        );


    }
    catch (error)
    {
        console.error(error);


        showMessage(
            "Unable to load available trips.",
            "error"
        );
    }
}


            // =========================================================
            // OPEN CREATE
            // =========================================================

            createAssignmentBtn.addEventListener(
                "click",
                async function() {

                    editMode = false;

                    selectedRow = null;


                    assignmentModalTitle.innerText =
                        "Create New Assignment";


                    saveAssignmentBtn.innerText =
                        "Save Assignment";


                    // =====================================================
                    // GET THE LATEST TRIPS FROM DATABASE
                    // =====================================================

                    await loadAvailableTrips();


                    // =====================================================
                    // CLEAR FORM
                    // =====================================================

                    document.getElementById("tripID").value =
                        "";

                    document.getElementById("driverID").value =
                        "";

                    document.getElementById("vehicleID").value =
                        "";

                    document.getElementById("assignedDate").value =
                        "";

                    document.getElementById("assignmentStatus").value =
                        "";


                    assignmentModal.classList.add("show");

                }
            );


            // =========================================================
            // CLOSE
            // =========================================================

            closeAssignmentModal.addEventListener(
                "click",
                function() {
                    assignmentModal.classList.remove("show");
                }
            );


            cancelAssignmentBtn.addEventListener(
                "click",
                function() {
                    assignmentModal.classList.remove("show");
                }
            );



            // =========================================================
            // SAVE
            // =========================================================

            saveAssignmentBtn.addEventListener(
                "click",
                async function() {

                    const tripID =
                        document.getElementById("tripID").value;


                    const driverID =
                        document.getElementById("driverID").value;


                    const vehicleID =
                        document.getElementById("vehicleID").value;


                    const assignedDate =
                        document.getElementById("assignedDate").value;


                    const status =
                        document.getElementById("assignmentStatus").value;



                    // VALIDATION

                    if (
                        tripID === "" ||
                        driverID === "" ||
                        vehicleID === "" ||
                        assignedDate === "" ||
                        status === ""
                    ) {

                        showMessage(
                            "Please complete all required fields.",
                            "warning"
                        );

                        return;
                    }



                    const formData =
                        new URLSearchParams();


                    formData.append(
                        "tripID",
                        tripID
                    );


                    formData.append(
                        "driverID",
                        driverID
                    );


                    formData.append(
                        "vehicleID",
                        vehicleID
                    );


                    formData.append(
                        "assignedDate",
                        assignedDate
                    );


                    formData.append(
                        "status",
                        status
                    );



                    // =====================================================
                    // UPDATE
                    // =====================================================

                    if (editMode && selectedRow) {

                        formData.append(
                            "assignmentID",
                            selectedRow.dataset.id
                        );


                        try {

                            const response =
                                await fetch(
                                    "/Assignment/Update",
                                    {
                                        method: "POST",

                                        headers:
                                        {
                                            "Content-Type":
                                                "application/x-www-form-urlencoded"
                                        },

                                        body:
                                            formData.toString()
                                    }
                                );


                            const result =
                                await response.json();


                            if (!result.success) {

                                showMessage(
                                    result.message ||
                                    "Unable to update assignment.",
                                    "error"
                                );

                                return;
                            }


                            // UPDATE ROW

                            selectedRow.dataset.tripId =
                                tripID;


                            selectedRow.dataset.driverId =
                                driverID;


                            selectedRow.dataset.vehicleId =
                                vehicleID;


                            selectedRow.dataset.assignedDate =
                                assignedDate;


                            selectedRow.dataset.status =
                                status;


                            selectedRow.cells[1].innerText =
                                "Trip #" + tripID;


                            const driverSelect =
                                document.getElementById("driverID");


                            const driverName =
                                driverSelect.options[
                                    driverSelect.selectedIndex
                                ].text;


                            selectedRow.cells[2].innerText =
                                driverName;


                            const vehicleSelect =
                                document.getElementById("vehicleID");


                            const vehicleName =
                                vehicleSelect.options[
                                    vehicleSelect.selectedIndex
                                ].text;


                            selectedRow.cells[3].innerText =
                                vehicleName;


                            selectedRow.cells[4].innerText =
                                assignedDate;


                            selectedRow.cells[5].innerText =
                                status;


                            selectedRow.classList.remove(
                                "assignment-updated"
                            );


                            showMessage(
                                "Assignment updated successfully."
                            );


                            assignmentModal.classList.remove(
                                "show"
                            );


                            editMode = false;

                            selectedRow = null;

                        }
                        catch (error) {

                            console.error(error);


                            showMessage(
                                "Unable to update assignment.",
                                "error"
                            );

                        }


                        return;
                    }



                    // =====================================================
                    // CREATE
                    // =====================================================

                    try {

                        const response =
                            await fetch(
                                "/Assignment/Create",
                                {
                                    method: "POST",

                                    headers:
                                    {
                                        "Content-Type":
                                            "application/x-www-form-urlencoded"
                                    },

                                    body:
                                        formData.toString()
                                }
                            );


                        const result =
                            await response.json();


                        if (!result.success) {

                            showMessage(
                                result.message ||
                                "Unable to create assignment.",
                                "error"
                            );

                            return;
                        }



                        const driverSelect =
                            document.getElementById("driverID");


                        const driverName =
                            driverSelect.options[
                                driverSelect.selectedIndex
                            ].text;


                        const vehicleSelect =
                            document.getElementById("vehicleID");


                        const vehicleName =
                            vehicleSelect.options[
                                vehicleSelect.selectedIndex
                            ].text;



                        // CREATE ROW

                        const row =
                            document.createElement("tr");


                        row.dataset.id =
                            result.assignmentId;


                        row.dataset.tripId =
                            tripID;


                        row.dataset.driverId =
                            driverID;


                        row.dataset.vehicleId =
                            vehicleID;


                        row.dataset.assignedDate =
                            assignedDate;


                        row.dataset.status =
                            status;



                        row.innerHTML = `

                            <td>

                                <div class="data-title">

                                    AS-${String(
                            result.assignmentId
                        ).padStart(3, "0")}

                                </div>

                            </td>


                            <td>

                                Trip #${tripID}

                            </td>


                            <td>

                                ${driverName}

                            </td>


                            <td>

                                ${vehicleName}

                            </td>


                            <td>

                                ${assignedDate}

                            </td>


                            <td>

                                ${status}

                            </td>


                            <td>

                                <button
                                    class="btn btn-secondary edit-btn">

                                    Edit

                                </button>


                                <button
                                    class="btn btn-danger delete-btn">

                                    Delete

                                </button>

                            </td>

                        `;


                        document
                            .getElementById(
                                "assignmentTableBody"
                            )
                            .prepend(row);



                        showMessage(
                            "Assignment created successfully."
                        );


                        assignmentModal.classList.remove(
                            "show"
                        );


                        editMode = false;

                        selectedRow = null;

                    }
                    catch (error) {

                        console.error(error);


                        showMessage(
                            "Unable to create assignment.",
                            "error"
                        );

                    }

                }
            );



            // =========================================================
            // EDIT / DELETE
            // =========================================================

            document.addEventListener(
                "click",
                async function(e) {


                    // =====================================================
                    // EDIT
                    // =====================================================

                    if (
                        e.target.classList.contains(
                            "edit-btn"
                        )
                    ) {

                        selectedRow =
                            e.target.closest("tr");


                        editMode = true;


                        assignmentModalTitle.innerText =
                            "Edit Assignment";


                        saveAssignmentBtn.innerText =
                            "Update Assignment";



                        document.getElementById(
                            "tripID"
                        ).value =
                            selectedRow.dataset.tripId;



                        document.getElementById(
                            "driverID"
                        ).value =
                            selectedRow.dataset.driverId;



                        document.getElementById(
                            "vehicleID"
                        ).value =
                            selectedRow.dataset.vehicleId;



                        document.getElementById(
                            "assignedDate"
                        ).value =
                            selectedRow.dataset.assignedDate;



                        document.getElementById(
                            "assignmentStatus"
                        ).value =
                            selectedRow.dataset.status;



                        assignmentModal.classList.add(
                            "show"
                        );


                        return;
                    }



                    // =====================================================
                    // DELETE
                    // =====================================================

                    if (
                        e.target.classList.contains(
                            "delete-btn"
                        )
                    ) {

                        const row =
                            e.target.closest("tr");


                        if (!row) {
                            return;
                        }


                        const id =
                            row.dataset.id;


                        if (!id) {

                            showMessage(
                                "Assignment ID not found.",
                                "error"
                            );

                            return;
                        }



                        try {

                            const response =
                                await fetch(
                                    "/Assignment/Delete",
                                    {
                                        method: "POST",

                                        headers:
                                        {
                                            "Content-Type":
                                                "application/x-www-form-urlencoded"
                                        },

                                        body:
                                            "id=" +
                                            encodeURIComponent(id)
                                    }
                                );


                            const result =
                                await response.json();


                            if (!result.success) {

                                showMessage(
                                    result.message ||
                                    "Unable to delete assignment.",
                                    "error"
                                );

                                return;
                            }


                            row.remove();


                            showMessage(
                                "Assignment deleted successfully."
                            );

                        }
                        catch (error) {

                            console.error(error);


                            showMessage(
                                "Unable to delete assignment.",
                                "error"
                            );

                        }

                    }

                }
            );



            // =========================================================
            // SEARCH
            // =========================================================

            const assignmentSearch =
                document.getElementById(
                    "assignmentSearch"
                );


            const statusFilter =
                document.getElementById(
                    "statusFilter"
                );


            function filterAssignments() {

                const keyword =
                    assignmentSearch.value
                        .toLowerCase()
                        .trim();


                const selectedStatus =
                    statusFilter.value;


                const rows =
                    document.querySelectorAll(
                        "#assignmentTableBody tr"
                    );


                rows.forEach(
                    function(row) {

                        const rowText =
                            row.innerText
                                .toLowerCase();


                        const rowStatus =
                            row.dataset.status;


                        const matchesSearch =
                            rowText.includes(
                                keyword
                            );


                        const matchesStatus =
                            selectedStatus === "all" ||
                            rowStatus === selectedStatus;


                        row.style.display =
                            matchesSearch &&
                                matchesStatus
                                ? ""
                                : "none";

                    }
                );

            }


            assignmentSearch.addEventListener(
                "input",
                filterAssignments
            );


            statusFilter.addEventListener(
                "change",
                filterAssignments
            );



            // =========================================================
            // CLOSE OUTSIDE
            // =========================================================

            window.addEventListener(
                "click",
                function(e) {

                    if (e.target === assignmentModal) {

                        assignmentModal.classList.remove(
                            "show"
                        );

                    }

                }
            );



            // =========================================================
            // ESC
            // =========================================================

            document.addEventListener(
                "keydown",
                function(e) {

                    if (e.key === "Escape") {

                        assignmentModal.classList.remove(
                            "show"
                        );

                    }

                }
            );



            // =========================================================
            // LOGOUT
            // =========================================================
            
                    const logoutBtn =
                        document.getElementById("logoutBtn");


                    if (logoutBtn) {

                        logoutBtn.addEventListener(
                            "click",
                            function() {

                                window.location.href =
                                    "/";

                            }
                        );

                    }

    </script>


</body>

</html>